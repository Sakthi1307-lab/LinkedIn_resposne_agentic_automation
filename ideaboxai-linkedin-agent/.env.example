# LinkedIn API (Community Management API partner access required)
# The token must be a 3-legged OAuth token minted with the Community
# Management scopes: r_organization_social w_organization_social rw_organization_admin
# A Sign-In (openid/profile/email) or Share (w_member_social) token is NOT enough —
# the /rest/socialActions and /rest/posts endpoints will return 403 partnerApi.
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_org_id_here
LINKEDIN_WEBHOOK_VERIFICATION_TOKEN=your_webhook_verification_token_here
# The app's OAuth Client Secret (Auth tab). LinkedIn signs the webhook
# validation challenge AND every event POST with THIS — required for webhooks.
LINKEDIN_CLIENT_SECRET=your_app_client_secret_here
# Community Management API version header (YYYYMM); LinkedIn keeps ~12 months active.
LINKEDIN_API_VERSION=202606

# OpenRouter (one key, multiple model access)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_HIGH_STAKES=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_STANDARD=openai/gpt-4-turbo
OPENROUTER_MODEL_FAST=openai/gpt-3.5-turbo

# Application
DEBUG=true
LOCAL_TEST_MODE=true
PORT=8000
DATABASE_URL=sqlite:///./ideaboxai_engage.db
LOG_LEVEL=INFO

# Safety gates
# AUTO_ESCALATE_HOSTILE_COMMENTS is not wired into main.py's pipeline —
# the agent runs in full-autonomy mode (no approval step, no escalation
# queue). Kept here only for src/escalation.py, which is available but
# unused unless you re-enable it yourself.
AUTO_ESCALATE_HOSTILE_COMMENTS=false
MAX_REPLIES_PER_PERSON_PER_HOUR=3
REPLY_DEDUP_WINDOW_HOURS=24

# Slack alerts (optional)
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#ideaboxai-engage-alerts
