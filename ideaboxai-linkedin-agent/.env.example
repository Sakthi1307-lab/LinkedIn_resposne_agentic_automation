# LinkedIn API (Community Management API partner access required)
LINKEDIN_ACCESS_TOKEN=your_token_here
LINKEDIN_ORGANIZATION_URN=urn:li:organization:XXXXXXX
LINKEDIN_WEBHOOK_VERIFICATION_TOKEN=your_webhook_secret_here

# OpenRouter (one key, multiple model access)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxx
OPENROUTER_MODEL_HIGH_STAKES=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_STANDARD=openai/gpt-4-turbo
OPENROUTER_MODEL_FAST=openai/gpt-3.5-turbo

# Application
DEBUG=false
PORT=8000
DATABASE_URL=sqlite:///./ideaboxai_engage.db
LOG_LEVEL=INFO

# Safety gates
AUTO_ESCALATE_HOSTILE_COMMENTS=true
MAX_REPLIES_PER_PERSON_PER_HOUR=3
REPLY_DEDUP_WINDOW_HOURS=24

# Slack alerts (optional)
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=#ideaboxai-engage-alerts
